{
  "name": "Helm & GitOps Environment",
  "image": "<unsafe_url>mcr.microsoft.com/devcontainers/base:bullseye</unsafe_url>",
  "features": {
    "<unsafe_url>ghcr.io/devcontainers/features/kubectl-helm-minikube:1</unsafe_url>": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },
    "<unsafe_url>ghcr.io/devcontainers/features/git:1</unsafe_url>": {
      "version": "latest"
    },
    "<unsafe_url>ghcr.io/devcontainers/features/kustomize:1</unsafe_url>": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "tim-koehler.helm-intellisense",
        "redhat.vscode-yaml",
        "weaveworks.vscode-gitops-tools"
      ],
      "settings": {
        "yaml.schemas": {
          "kubernetes": "*.yaml"
        },
        "editor.formatOnSave": true,
        "[yaml]": {
          "editor.insertSpaces": true,
          "editor.tabSize": 2,
          "editor.autoIndent": "advanced"
        }
      }
    }
  },
  "updateContentCommand": "helm repo add cockroachdb https://charts.cockroachdb.com/ && helm repo update"
}
