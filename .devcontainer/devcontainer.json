{
  "name": "Helm & GitOps Environment",
  "image": "mcr.microsoft.com/devcontainers/base:bullseye",
  "features": {
    "ghcr.io/devcontainers/features/helm:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/kubectl:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "tim-koehler.helm-intellisense",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "yaml.schemas": {
          "kubernetes": "*.yaml"
        },
        "editor.formatOnSave": true,
        "[yaml]": {
          "editor.insertSpaces": true,
          "editor.tabSize": 2,
          "editor.autoIndent": "advanced"
        }
      }
    }
  },
  "postCreateCommand": "helm repo add heroiclabs https://heroiclabs.github.io/helm-charts && helm repo update"
}